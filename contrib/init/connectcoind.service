# It is not recommended to modify this file in-place, because it will
# be overwritten during package upgrades. If you want to add further
# options or overwrite existing ones then use
# $ systemctl edit connectcoind.service
# See "man systemd.service" for details.

# Note that almost all daemon options could be specified in
# /etc/connectcoin/connectcoin.conf, but keep in mind those explicitly
# specified as arguments in ExecStart= will override those in the
# config file.

[Unit]
Description=ConnectCoin daemon
Documentation=man:connectcoind(1)

# https://www.freedesktop.org/wiki/Software/systemd/NetworkTarget/
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/connectcoind -pid=/run/connectcoind/connectcoind.pid \
                            -conf=/etc/connectcoin/connectcoin.conf \
                            -datadir=/var/lib/connectcoind \
                            -startupnotify='systemd-notify --ready' \
                            -shutdownnotify='systemd-notify --stopping'

# An explicitly selected -conf file must exist. Create an empty one on the
# first start; cookie authentication remains the secure default. Keep the
# directory root-owned so the daemon cannot replace the file with a symlink.
# The '+' prefix runs these preparation commands with full privileges.
# ConfigurationDirectory ensures the path exists before they run, while
# ProtectSystem=full still applies to the daemon itself.
ExecStartPre=+/usr/bin/install -d -o root -g connectcoin -m 0750 /etc/connectcoin
ExecStartPre=+/bin/sh -c 'p=/etc/connectcoin/connectcoin.conf; if [ -L "$p" ] || { [ -e "$p" ] && [ ! -f "$p" ]; }; then echo "ERROR: $p must be a regular file, not a symlink" >&2; exit 1; fi; if [ ! -e "$p" ]; then umask 0027; : > "$p"; fi; chown root:connectcoin "$p"; chmod 0640 "$p"'
ExecStartPre=/bin/test -r /etc/connectcoin/connectcoin.conf

# Process management
####################

Type=notify
NotifyAccess=all
PIDFile=/run/connectcoind/connectcoind.pid

Restart=on-failure
TimeoutStartSec=infinity
TimeoutStopSec=600

# Directory creation and permissions
####################################

# Run as connectcoin:connectcoin
User=connectcoin
Group=connectcoin

# /run/connectcoind
RuntimeDirectory=connectcoind
RuntimeDirectoryMode=0710

# /etc/connectcoin
ConfigurationDirectory=connectcoin
ConfigurationDirectoryMode=0710

# /var/lib/connectcoind
StateDirectory=connectcoind
StateDirectoryMode=0710

# Hardening measures
####################

# Provide a private /tmp and /var/tmp.
PrivateTmp=true

# Mount /usr, /boot/ and /etc read-only for the process.
ProtectSystem=full

# Deny access to /home, /root and /run/user
ProtectHome=true

# Disallow the process and all of its children to gain
# new privileges through execve().
NoNewPrivileges=true

# Use a new /dev namespace only populated with API pseudo devices
# such as /dev/null, /dev/zero and /dev/random.
PrivateDevices=true

# Deny the creation of writable and executable memory mappings.
MemoryDenyWriteExecute=true

# Restrict ABIs to help ensure MemoryDenyWriteExecute is enforced
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
