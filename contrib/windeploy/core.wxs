<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright (c) 2026 The ConnectCoin Core developers. MIT license. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ConnectCoin Core" Manufacturer="ConnectCoin Core developers"
           Version="$(var.PackageVersion)" Language="1046" Codepage="1252"
           UpgradeCode="68B91A0E-90D2-4B52-B9F5-5DE859A401DB"
           Scope="perMachine" InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="ConnectCoin Core $(var.CoreVersion) - Windows x64"
                        Manufacturer="ConnectCoin Core developers" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do ConnectCoin Core já está instalada."
                  Schedule="afterInstallInitialize" />
    <!-- A rebuilt MSI must increment its three-field version, not install a
         second product with the same version and shared component identities. -->
    <Upgrade Id="68B91A0E-90D2-4B52-B9F5-5DE859A401DB">
      <UpgradeVersion Minimum="$(var.PackageVersion)" Maximum="$(var.PackageVersion)"
                      IncludeMinimum="yes" IncludeMaximum="yes" OnlyDetect="yes"
                      Property="SAMEVERSIONFOUND" />
    </Upgrade>
    <Launch Condition="Installed OR NOT SAMEVERSIONFOUND"
            Message="Esta versão já está instalada. Use o pacote original para reparar ou desinstale a versão existente antes de instalar este pacote." />
    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 17763)"
            Message="Este instalador requer Windows 10 versão 1809 ou posterior, de 64 bits." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPPRODUCTICON" Value="CoreIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://connectcoincrypto.com/" />
    <Property Id="ARPHELPLINK" Value="https://github.com/connectcoincrypto/connectcoin/issues" />
    <!-- Never terminate/restart a running wallet or node automatically. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM"
                      Key="Software\ConnectCoin Core\Installer" Name="InstallDir"
                      Type="raw" Bitness="always64" />
    </Property>
    <Icon Id="CoreIcon" SourceFile="$(var.RepoDir)\share\pixmaps\connectcoin.ico" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ConnectCoin Core">
        <Directory Id="BINFOLDER" Name="bin" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CoreMenuFolder" Name="ConnectCoin Core" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallerRegistration" Guid="*" Bitness="always64">
        <RegistryValue Root="HKLM" Key="Software\ConnectCoin Core\Installer"
                       Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <RemoveFolder Id="RemoveEmptyMenu" Directory="CoreMenuFolder" On="uninstall" />
      </Component>
      <!-- Register a candidate handler, without hijacking ConnectWallet's
           connectcoin: association or changing protected UserChoice settings. -->
      <Component Id="PaymentLinkRegistration" Guid="*" Bitness="always64">
        <RegistryValue Root="HKLM" Key="Software\Classes\ConnectCoinCore.PaymentLink"
                       Value="URL:ConnectCoin payment" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ConnectCoinCore.PaymentLink"
                       Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ConnectCoinCore.PaymentLink\DefaultIcon"
                       Value="&quot;[#GuiExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ConnectCoinCore.PaymentLink\shell\open\command"
                       Value="&quot;[#GuiExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ConnectCoin Core\Capabilities"
                       Name="ApplicationName" Value="ConnectCoin Core" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ConnectCoin Core\Capabilities"
                       Name="ApplicationDescription" Value="Carteira e nó completo ConnectCoin" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ConnectCoin Core\Capabilities"
                       Name="ApplicationIcon" Value="&quot;[#GuiExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ConnectCoin Core\Capabilities\URLAssociations"
                       Name="connectcoin" Value="ConnectCoinCore.PaymentLink" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications"
                       Name="ConnectCoin Core" Value="Software\ConnectCoin Core\Capabilities" Type="string" />
      </Component>
    </DirectoryRef>
    <Feature Id="Core" Title="ConnectCoin Core" Level="1" AllowAbsent="no" AllowAdvertise="no">
      <ComponentGroupRef Id="CorePayload" />
      <ComponentRef Id="InstallerRegistration" />
      <ComponentRef Id="PaymentLinkRegistration" />
    </Feature>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
